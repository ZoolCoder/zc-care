# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#f7f7f4"

# Main text color
theme[main_fg]="#111318"

# Title color for boxes
theme[title]="#111318"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#1a45c2"

# Background color of selected item in processes box
theme[selected_bg]="#cbcbc2"

# Foreground color of selected item in processes box
theme[selected_fg]="#1a45c2"

# Color of inactive/disabled text
theme[inactive_fg]="#646973"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#1a45c2"

# Background color of the percentage meters
theme[meter_bg]="#cbcbc2"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#1a45c2"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#2457e6"
theme[mem_box]="#0b7f4a" #Green
theme[net_box]="#a31f25" #Maroon
theme[proc_box]="#1a45c2" #Blue

# Box divider line and small boxes line color
theme[div_line]="#8a8f99"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#0b7f4a"
theme[temp_mid]="#8a5300"
theme[temp_end]="#c2262c"

# CPU graph colors
theme[cpu_start]="#0B7F7A"
theme[cpu_mid]="#1f6fd1"
theme[cpu_end]="#3d6bea"

# Mem/Disk free meter
theme[free_start]="#2457e6"
theme[free_mid]="#3d6bea"
theme[free_end]="#1a45c2"

# Mem/Disk cached meter
theme[cached_start]="#1f6fd1"
theme[cached_mid]="#1a45c2"
theme[cached_end]="#3d6bea"

# Mem/Disk available meter (Peach -> Red)
theme[available_start]="#b35c00"
theme[available_mid]="#a31f25"
theme[available_end]="#c2262c"

# Mem/Disk used meter (Green -> Sky)
theme[used_start]="#0b7f4a"
theme[used_mid]="#0B7F7A"
theme[used_end]="#0e7fb0"

# Download graph colors (Peach -> Red)
theme[download_start]="#b35c00"
theme[download_mid]="#a31f25"
theme[download_end]="#c2262c"

# Upload graph colors (Green -> Sky)
theme[upload_start]="#0b7f4a"
theme[upload_mid]="#0B7F7A"
theme[upload_end]="#0e7fb0"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#1f6fd1"
theme[process_mid]="#3d6bea"
theme[process_end]="#2457e6"